# L30 Tools API credentials (copy to .env and fill in real values)
# Bearer token format: <keyId>.<secret>

L30_TOOLS_API_TOKEN=your_key_id.your_secret

# Optional split auth instead of L30_TOOLS_API_TOKEN
# L30_API_KEY_ID=your_key_id
# L30_API_SECRET=your_secret

# Optional base URL override
# L30_TOOLS_API_BASE=https://l30on.top/api/v2/tools
